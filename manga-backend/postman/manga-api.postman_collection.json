{
  "info": {
    "name": "Manga Sheva API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET semua manga",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manga",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga"
          ]
        }
      }
    },
    {
      "name": "GET filter judul",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manga?judul=one",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga"
          ],
          "query": [
            {
              "key": "judul",
              "value": "one"
            }
          ]
        }
      }
    },
    {
      "name": "GET statistik",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manga/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga",
            "stats"
          ]
        }
      }
    },
    {
      "name": "GET manga by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manga/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga",
            "1"
          ]
        }
      }
    },
    {
      "name": "POST tambah manga",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/manga",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Berserk\",\n  \"genre\": \"Fantasi\",\n  \"image\": \"\",\n  \"description\": \"Perjalanan Guts.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PATCH ubah manga",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/manga/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"genre\": \"Aksi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "DELETE hapus manga",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manga/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga",
            "1"
          ]
        }
      }
    },
    {
      "name": "GET id tidak ada (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/manga/999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga",
            "999"
          ]
        }
      }
    },
    {
      "name": "POST judul kosong (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/manga",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "manga"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}